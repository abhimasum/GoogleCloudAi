# Google Cloud AI Agent Configuration
# ====================================
# Copy this file to .env in agents/retriever_agent, agents/orchestrator_agent, 
# or ingestion as needed, and fill in your own values.
# 
# NEVER commit a real .env file to git - it contains sensitive information!
#
# For detailed instructions on finding these values, see: docs/SETUP.md

# ════════════════════════════════════════════════════════════════
# CORE CONFIGURATION (required in all services)
# ════════════════════════════════════════════════════════════════

# Your GCP Project ID (not the display name)
# Find: Google Cloud Console → Project Settings → Project ID
GOOGLE_CLOUD_PROJECT=agenticaigcplearn

# GCP Region where your services run
# NOTE: Use europe-west4 for RAG Engine (us-central1 restricted for new projects)
# Options: europe-west4, us-west1, asia-southeast1
GOOGLE_CLOUD_LOCATION=europe-west4

# Enable Vertex AI backend for Gemini models
GOOGLE_GENAI_USE_VERTEXAI=true

# ════════════════════════════════════════════════════════════════
# RETRIEVER AGENT CONFIG (agents/retriever_agent)
# ════════════════════════════════════════════════════════════════

# Full RAG corpus resource name (used by retriever to query documents)
# Find: Run: gcloud ai documents corpus list --location=europe-west4
# Format: projects/{PROJECT_NUMBER}/locations/{LOCATION}/ragCorpora/{CORPUS_ID}
RAG_CORPUS=projects/1073291557100/locations/europe-west4/ragCorpora/4611686018427387904

# Public URL where retriever agent is deployed (for A2A agent card)
# Local development: http://localhost:8081
# Cloud Run: https://retriever-agent-xxxxx.run.app
PUBLIC_URL=http://localhost:8081

# Port for retriever agent HTTP server
PORT=8081

# ════════════════════════════════════════════════════════════════
# ORCHESTRATOR AGENT CONFIG (agents/orchestrator_agent)
# ════════════════════════════════════════════════════════════════

# URL of retriever agent (for A2A delegation)
# Local development: http://localhost:8081
# Cloud Run: https://retriever-agent-xxxxx.run.app
RETRIEVER_AGENT_URL=http://localhost:8081

# Port for orchestrator agent HTTP server
PORT=8000

# Optional: URL for persistent conversation storage
# SESSION_DB_URL=postgresql://user:password@host/database

# ════════════════════════════════════════════════════════════════
# INGESTION SERVICE CONFIG (ingestion)
# ════════════════════════════════════════════════════════════════

# Cloud Storage bucket where documents are stored
# Format: gs://bucket-name or gs://bucket-name/prefix/
# NOTE: Use bucket path without wildcards (SDK discovers files recursively)
RAG_GCS_SOURCE=gs://agenticaigcplearn-adk-docs

# Numeric RAG corpus ID (used for re-ingestion to reuse existing corpus)
# Find: Last number in RAG_CORPUS resource name above
# Example: 4611686018427387904
RAG_CORPUS_ID=4611686018427387904

# Optional: Custom display name for corpus (only used when creating new corpus)
# RAG_CORPUS_DISPLAY_NAME=my-custom-knowledge-base

# ════════════════════════════════════════════════════════════════
# CLOUD RUN DEPLOYMENT CONFIG (optional, for production)
# ════════════════════════════════════════════════════════════════

# GCP Project number (used by Workload Identity Federation)
# Find: Google Cloud Console → Project Settings → Project number
GCP_PROJECT_NUMBER=1073291557100

# Artifact Registry repository for Docker images
# Format: {REGION}-docker.pkg.dev/{PROJECT_ID}/{REPO_NAME}
GCS_ARTIFACT_REGISTRY=europe-west4-docker.pkg.dev/agenticaigcplearn/adk-agents

# Cloud Storage bucket for ingestion service output
# Same as RAG_GCS_SOURCE bucket
GCS_BUCKET=agenticaigcplearn-adk-docs

# ════════════════════════════════════════════════════════════════
# GITHUB ACTIONS DEPLOYMENT CONFIG (for CI/CD, optional)
# ════════════════════════════════════════════════════════════════

# Workload Identity Federation provider (set by infra/setup_wif_github_actions.sh)
# Format: projects/{PROJECT_NUMBER}/locations/global/workloadIdentityPools/{POOL_ID}/providers/{PROVIDER_ID}
GCP_WORKLOAD_IDENTITY_PROVIDER=projects/1073291557100/locations/global/workloadIdentityPools/github-pool/providers/github-provider

# Service account for GitHub Actions (set by infra/setup_wif_github_actions.sh)
# Format: {SERVICE_ACCOUNT}@{PROJECT_ID}.iam.gserviceaccount.com
GCP_SERVICE_ACCOUNT=github-deployer@agenticaigcplearn.iam.gserviceaccount.com

# ════════════════════════════════════════════════════════════════
# HELP: Finding Your Values
# ════════════════════════════════════════════════════════════════
#
# PROJECT_ID:
#   gcloud config get-value project
#
# PROJECT_NUMBER:
#   gcloud projects describe $(gcloud config get-value project) --format='value(projectNumber)'
#
# RAG_CORPUS and CORPUS_ID:
#   gcloud ai documents corpus list --location=europe-west4
#   (from the output, extract the numeric ID and full resource name)
#
# RETRIEVER_AGENT_URL (Cloud Run):
#   gcloud run services describe retriever-agent --region=europe-west4 --format='value(status.url)'
#
# Artifact Registry:
#   gcloud artifacts repositories list --location=europe-west4
