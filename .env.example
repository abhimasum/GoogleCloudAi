# Copy to .env in agents/retriever_agent, agents/orchestrator_agent, or ingestion
# as needed, and fill in your own values. Never commit a real .env file.

GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true

# retriever_agent
RAG_CORPUS=projects/your-project-id/locations/us-central1/ragCorpora/your-corpus-id
PUBLIC_URL=http://localhost:8081

# orchestrator_agent
RETRIEVER_AGENT_URL=http://localhost:8081

# ingestion
RAG_GCS_SOURCE=gs://your-project-id-adk-docs/docs/*
RAG_CORPUS_ID=your-corpus-id
